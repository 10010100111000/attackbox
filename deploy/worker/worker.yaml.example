# 参考模板：实际运行配置请使用 sudo ./scripts/worker.sh setup 生成至 /etc/attackbox/worker.yaml。
# 使用时长、空闲回收在后台「运行策略」设置；容量、内存和进程数在「节点管理」设置。
node:
  node_id: "node-primary"
  cluster_secret: "CHANGE_ME_AT_LEAST_32_BYTES"
  control_url: "ws://127.0.0.1:3000/cluster/connect"
  heartbeat_interval_sec: 3

gateway:
  listen_addr: "0.0.0.0:8443"
  # 浏览器实际访问的地址，与 web.env 的 publicDataUrl 一致；HTTPS 页面必须使用 WSS。
  # 此回环示例仅用于本机浏览器；跨机器访问时填写真实域名或 IP，不使用 listen_addr 作为公开地址。
  public_data_url: "ws://127.0.0.1:8443"
  tls_enabled: false

runtime:
  base_rootfs: "/var/lib/attackbox/base_rootfs"
  instances_dir: "/var/lib/attackbox/instances"
  cgroup_root: "/sys/fs/cgroup/attackbox"
  disk_guard:
    enabled: true
    check_interval_sec: 3
    min_free_space_mb: 5120
    warn_free_space_mb: 10240

network:
  bridge_name: "br-attackbox"
  gateway_ip: "10.200.0.1"
  subnet_cidr: "10.200.0.0/16"
  egress_interface: "" # 留空按默认路由检测。

compose_labs:
  enabled: false
  network_verified: false # 本机网络验收通过后，再开启此项与 enabled。
  state_dir: "/var/lib/attackbox/compose-labs"
  socket_path: "/var/run/docker.sock"
  pool: "10.202.0.0/16" # 不得与主网、VPN 或其他 Docker 网络重叠。
