# Reference only: sudo ./scripts/control.sh setup generates /etc/attackbox/web.env.
# Deployment settings and secrets; business runtime policies are stored in PostgreSQL.
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgres://attackbox:CHANGE_ME@127.0.0.1:5432/attackbox_db
SANDBOX_CONTROL_ENABLED=true
SANDBOX_SCHEDULING_ENABLED=true
SANDBOX_CLUSTER_SECRET=CHANGE_ME_AT_LEAST_32_BYTES
SANDBOX_SIGNING_SEED_HEX=CHANGE_ME_64_HEX_CHARS
# publicDataUrl must be reachable by the browser and match gateway.public_data_url.
# This loopback example is local-only. Use the actual hostname/IP for remote browsers.
# HTTPS websites require wss://. CLI/GUI use this address without rewriting it.
SANDBOX_NODES_JSON=[{"id":"node-primary","label":"Primary Node","publicDataUrl":"ws://127.0.0.1:8443","maxSlots":16}]
# Git tutorial sync: persistent data outside .output; writable by attackbox-web service user.
CONTENT_DATA_DIR=/var/lib/attackbox-web/content
# Public, generated reference HTML only; nginx reads this independent directory.
REFERENCE_PUBLIC_DIR=/var/lib/attackbox-public/references
LAB_DATA_DIR=/var/lib/attackbox-web/labs
# Generate once with openssl rand -hex 32; retain it across redeploys and backups.
CONTENT_CREDENTIALS_KEY=CHANGE_ME_64_HEX_CHARS

# Resend: verified sending domain; API key stays on the Nuxt server.
RESEND_API_KEY=
MAIL_FROM=
# Public site origin, used in email links; HTTPS required except local testing.
APP_BASE_URL=http://127.0.0.1

# Optional registration domain allowlist (comma-separated exact domains).
# Omit to use Gmail/Microsoft/Apple/QQ/NetEase/Yahoo/Aliyun defaults.
# An empty value or wildcard is invalid; existing account login/reset is unaffected.
# AUTH_REGISTRATION_EMAIL_DOMAINS=gmail.com,outlook.com,qq.com,163.com

# Cloudflare Turnstile: both absent disables the widget; partial config rejects authentication.
# Site Key is public. Secret Key is server-only; obtain both from the Turnstile dashboard.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Trust forwarded client IPs only from local nginx. Change only for a known proxy topology.
# X-Real-IP must be overwritten by the trusted proxy; otherwise strip it and use X-Forwarded-For.
# For multi-hop X-Forwarded-For, list every trusted proxy CIDR; traversal stops at the first untrusted hop.
# AUTH_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128

# Optional single-host Cloudflare HTTPS template; see docs/deployment/cloudflare.md.
CLOUDFLARE_ENABLED=false
# ORIGIN_TLS_CERT=/etc/ssl/attackbox/origin.pem
# ORIGIN_TLS_KEY=/etc/ssl/attackbox/origin.key
# WORKER_PROXY_UPSTREAM=127.0.0.1:8443
