# Generated by control deploy. Single-host Cloudflare ingress; no public Worker port.
upstream attackbox_control {
    server @@WEB_UPSTREAM@@;
}
upstream attackbox_worker {
    server @@WORKER_UPSTREAM@@;
}

# Use the connection peer BEFORE real_ip rewrites the address to the visitor IP.
geo $realip_remote_addr $attackbox_cloudflare_peer {
    default 0;
@@CLOUDFLARE_GEO@@
}
@@CLOUDFLARE_REAL_IP@@
real_ip_header CF-Connecting-IP;
real_ip_recursive off;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    listen [::]:80;
    server_name @@DOMAIN@@;
    if ($attackbox_cloudflare_peer = 0) { return 444; }
    return 301 https://@@DOMAIN@@$request_uri;
}
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    ssl_reject_handshake on;
    return 444;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @@DOMAIN@@;
    ssl_certificate @@TLS_CERT@@;
    ssl_certificate_key @@TLS_KEY@@;
    ssl_protocols TLSv1.2 TLSv1.3;
    if ($attackbox_cloudflare_peer = 0) { return 444; }

    client_max_body_size 50M;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    # Same-host Worker connects directly to loopback Nuxt.
    location = /cluster/connect { return 404; }

    # These locations need the full header set: nginx does not merge parent
    # proxy_set_header directives when a child declares its own directives.
    location = /ws/cli {
        access_log off; # URLs carry short-lived gateway tickets.
        proxy_pass http://attackbox_worker;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
    location = /ws/gui {
        access_log off;
        proxy_pass http://attackbox_worker;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
    location /api/auth/ {
        client_max_body_size 16k;
        add_header Cache-Control "no-store" always;
        proxy_pass http://attackbox_control;
    }
@@REFERENCE_LOCATIONS@@

    location / {
        proxy_pass http://attackbox_control;
    }
}
