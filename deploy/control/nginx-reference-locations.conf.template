    # Only published reference files are public; staging/release directories have no URL.
    location ~ "^/static-refs/(?<ref_slug>[a-zA-Z0-9_-]{1,100})/meta\.json$" {
        alias @@REFERENCE_PUBLIC_DIR@@/$ref_slug/meta.json;
        default_type application/json;
        charset utf-8;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location ~ "^/static-refs/(?<ref_slug>[a-zA-Z0-9_-]{1,100})/(?<ref_revision>[a-f0-9]{64})/(?<ref_chunk>chunk-[0-9]+\.html)$" {
        alias @@REFERENCE_PUBLIC_DIR@@/$ref_slug/$ref_revision/$ref_chunk;
        default_type text/html;
        charset utf-8;
        gzip_static on;
        gzip_vary on;
        add_header Cache-Control "public, max-age=3600";
        add_header X-Content-Type-Options nosniff always;
    }
    location /static-refs/ { return 404; }
