[Unit]
Description=attackbox single-port gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/attackboxd -config /etc/attackbox/config.json
Restart=on-failure
RestartSec=2
KillMode=process
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
