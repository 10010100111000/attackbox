[Unit]
Description=AttackBox Go Worker
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/laji/attackbox
ExecStart=/home/laji/attackbox/bin/node -config /etc/attackbox/node.yaml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target