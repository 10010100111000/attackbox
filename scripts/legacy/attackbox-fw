#!/bin/bash
# attackbox egress policy for every box* user, via one nft uid set.
# No per-user rules, so growing the pool only means re-running this.
set -u
LAB=10.10.0.0/16
DNS1=1.1.1.1
DNS2=1.0.0.1

UIDS=$(getent passwd | awk -F: '$1 ~ /^box[0-9]+$/ {print $3}' | paste -sd, -)
if [ -z "$UIDS" ]; then
  echo "attackbox-fw: no box users found" >&2
  exit 1
fi

nft delete table inet attackbox 2>/dev/null
nft add table inet attackbox
nft add set inet attackbox boxuids '{ type uid; }'
nft add element inet attackbox boxuids "{ $UIDS }"
nft add chain inet attackbox out '{ type filter hook output priority filter; }'
nft add rule inet attackbox out meta skuid @boxuids ip  daddr 127.0.0.0/8 accept
nft add rule inet attackbox out meta skuid @boxuids ip6 daddr ::1 accept
nft add rule inet attackbox out meta skuid @boxuids udp dport 53 ip daddr "$DNS1" accept
nft add rule inet attackbox out meta skuid @boxuids tcp dport 53 ip daddr "$DNS1" accept
nft add rule inet attackbox out meta skuid @boxuids udp dport 53 ip daddr "$DNS2" accept
nft add rule inet attackbox out meta skuid @boxuids tcp dport 53 ip daddr "$DNS2" accept
nft add rule inet attackbox out meta skuid @boxuids ip daddr "$LAB" accept
nft add rule inet attackbox out meta skuid @boxuids reject
