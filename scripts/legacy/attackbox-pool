#!/bin/bash
# attackbox-pool - 机器池。box 用户是可复用的槽位，不是一人一个。
#   attackbox-pool ensure <N>   确保 box1..boxN 存在 (已存在的不动)
#   attackbox-pool list         列出池子与占用
#   attackbox-pool start <i>    起第 i 个槽位
#   attackbox-pool stop <i>
#   attackbox-pool stopall
set -u
ACTION="$1"
if [ -z "$ACTION" ]; then ACTION=list; fi
RUNDIR=/run/attackbox
SESSION_SCRIPT=/usr/local/lib/attackbox/box-session.sh

disp_of() { echo $(( $1 + 4 )); }

ensure_one() {
  local i="$1"
  local u="box$i"
  if ! id "$u" >/dev/null 2>&1; then
    useradd -m -s /bin/bash "$u" >/dev/null 2>&1 && echo "  created $u (display :$(disp_of $i))"
  fi
  install -d -o "$u" -g "$u" -m 0700 "$RUNDIR/$u" "$RUNDIR/$u/xdg" 2>/dev/null
}

start_one() {
  local i="$1"
  local u="box$i"
  local d
  d=$(disp_of "$i")
  ensure_one "$i" >/dev/null
  systemctl stop "attackbox-$u-gui" 2>/dev/null
  systemctl reset-failed "attackbox-$u-gui" 2>/dev/null
  pkill -u "$u" 2>/dev/null
  systemd-run --unit="attackbox-$u-gui" --collect --no-block \
    --property=User="$u" --property=Group="$u" \
    --property=WorkingDirectory="/home/$u" \
    --property=MemoryMax=1200M --property=CPUQuota=120% \
    --property=Slice=attackbox.slice \
    --property=KillMode=control-group --property=TimeoutStopSec=15 \
    --property=StandardOutput=journal --property=StandardError=journal \
    "$SESSION_SCRIPT" "$u" "$d" "$RUNDIR/$u" "$RUNDIR/$u/gui.sock" >/dev/null 2>&1
}

case "$ACTION" in
  ensure)
    N="$2"
    for i in $(seq 1 "$N"); do ensure_one "$i"; done
    /usr/local/sbin/attackbox-fw
    ;;
  list)
    printf '%-7s %-6s %-8s %-10s %s\n' USER UID DISPLAY SESSION SOCKET
    for u in $(getent passwd | awk -F: '$1 ~ /^box[0-9]+$/ {print $1}' | sort -V); do
      n=$(echo "$u" | sed 's/^box//')
      s=$(systemctl is-active "attackbox-$u-gui" 2>/dev/null)
      if [ -z "$s" ]; then s=inactive; fi
      if [ -S "$RUNDIR/$u/gui.sock" ]; then k=yes; else k=no; fi
      printf '%-7s %-6s :%-7s %-10s %s\n' "$u" "$(id -u $u)" "$(disp_of $n)" "$s" "$k"
    done
    ;;
  start)  start_one "$2"; echo "  started box$2" ;;
  stop)
    systemctl stop "attackbox-box$2-gui" 2>/dev/null
    pkill -u "box$2" 2>/dev/null
    echo "  stopped box$2"
    ;;
  stopall)
    for u in $(getent passwd | awk -F: '$1 ~ /^box[0-9]+$/ {print $1}'); do
      systemctl stop "attackbox-$u-gui" 2>/dev/null
      pkill -u "$u" 2>/dev/null
    done
    echo "  all stopped"
    ;;
  *) echo "usage: attackbox-pool ensure <N> | list | start <i> | stop <i> | stopall" ;;
esac
